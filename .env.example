# Copia este fichero a .env y rellena solo lo que uses.
# No hace falta ninguna clave: sin IA la búsqueda por palabra clave funciona igual.

# --- Corpus -----------------------------------------------------------------
# Por defecto ./legalize-es (lo que crea ./setup-corpus.sh).
# Descomenta si ya tienes el corpus clonado en otro sitio.
#CORPUS_PATH=/ruta/a/legalize-es

# --- IA local (llama.cpp en GPU) --------------------------------------------
#LOCAL_LLM_URL=http://127.0.0.1:8080/v1

# --- HuggingFace (nube, gratuito) -------------------------------------------
# Habilita además el reordenado semántico de resultados.
#HF_TOKEN=

# --- Anthropic (máxima precisión normativa) ---------------------------------
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-opus-5
